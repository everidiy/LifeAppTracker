<Window x:Class="HabitsTracker.Windows.AddNewHabitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitsTracker"
        mc:Ignorable="d"
        WindowStartupLocation="Manual"
        Title="Добавить новую привычку" Height="550" Width="350">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                         RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
            <GradientStop Color="#FFA3D8F4" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>
    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
                    CornerRadius="8" 
                    BorderThickness="1.5" 
                    BorderBrush="#87CEEB"
                    Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AeroBodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AeroHeaderGotIt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                            CornerRadius="6" 
                            BorderThickness="1.5" 
                            BorderBrush="#B0E0E6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#F9FBFD" Offset="0.5"/>
                                    <GradientStop Color="#F0F8FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" 
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0099FF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#87CEEB" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#B0E0E6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#F4FAFC" Offset="0.4"/>
                        <GradientStop Color="#E6F2F7" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ToggleButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border CornerRadius="6" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="1" 
                                          Data="M 0 0 L 4 4 L 8 0 Z" 
                                          Fill="#003366" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0FFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B0E0E6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="AddTitle" Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Взрастите новую привычку" 
                   Style="{StaticResource AeroHeaderGotIt}"/>
            <TextBlock Text="Поразмышляйте о своих целях. 
                       Маленькие действия сегодня создают круги на воде вашего будущего"
                   Style="{StaticResource AeroBodyText}"
                   TextWrapping="Wrap" 
                   HorizontalAlignment="Center" 
                   TextAlignment="Center" 
                   Margin="0,5,0,0"
                   Name="Description"/>
        </StackPanel>

        <StackPanel x:Name="AddBody" Grid.Row="1" Width="250" HorizontalAlignment="Center">

            <TextBlock Text="Название:" Style="{StaticResource AeroBodyText}" Margin="0,0,0,3"/>
            <TextBox x:Name="HabitNameInput" 
                 Height="30"
                 VerticalContentAlignment="Center" 
                 Padding="5,0"
                 FontSize="14"
                 Margin="0,0,0,12"/>

            <TextBlock Text="Регулярность:" Style="{StaticResource AeroBodyText}" Margin="0,0,0,3"/>
            <ComboBox x:Name="RegularitySelect" Height="30" SelectedIndex="0" Margin="0,0,0,12">
                <ComboBoxItem Content="Каждый день"/>
                <ComboBoxItem Content="Через день"/>
                <ComboBoxItem Content="По будням"/>
                <ComboBoxItem Content="По выходным"/>
                <ComboBoxItem Content="Раз в неделю"/>
            </ComboBox>

            <TextBlock Text="Категория:" Style="{StaticResource AeroBodyText}" Margin="0,0,0,3"/>
            <ComboBox x:Name="CategorySelect" Height="30" SelectedIndex="0" Margin="0,0,0,12">
                <ComboBoxItem Content="Здоровье и спорт"/>
                <ComboBoxItem Content="Разум и образование"/>
                <ComboBoxItem Content="Рутина и дом"/>
                <ComboBoxItem Content="Работа и финансы"/>
                <ComboBoxItem Content="Творчество и хобби"/>
            </ComboBox>

            <TextBlock Text="Заметка:" Style="{StaticResource AeroBodyText}" Margin="0,0,0,3"/>
            <TextBox x:Name="HabitNoteInput" 
                 Height="60" 
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalContentAlignment="Top" 
                 Padding="5" 
                 FontSize="13"
                 Margin="0,0,0,15"/>
        </StackPanel>

        <StackPanel x:Name="AddBtn" Grid.Row="2" Margin="0,10,0,0">
            <Button Content="Добавить" 
                Width="120"
                Style="{StaticResource ToolsBtn}"
                Click="Add_Click"/>
        </StackPanel>
    </Grid>

</Window>

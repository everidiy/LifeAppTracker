<Window x:Class="HabitsTracker.Windows.ConfirmSave"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitsTracker"
        mc:Ignorable="d"
        Title="Сохранить?"
        Height="200" Width="420"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize" 
        ShowInTaskbar="False">
    
    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
            CornerRadius="8" 
            BorderThickness="1.5" 
            BorderBrush="#87CEEB"
            Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AeroHeaderGotIt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                     RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
            <GradientStop Color="#FFA3D8F4" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Ваши изменения будут сохранены. Вы уверены, что хотите этого?"
                       TextWrapping="Wrap"
                       Style="{StaticResource AeroHeaderGotIt}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Да" 
                    Width="90" 
                    Height="30" 
                    Margin="0,0,15,0" 
                    IsDefault="True" 
                    Click="YesButton_Click"
                    Style="{StaticResource ToolsBtn}">
            </Button>

            <Button Content="Нет" 
                    Width="90" 
                    Height="30" 
                    IsCancel="True" 
                    Click="NoButton_Click"
                    Style="{StaticResource ToolsBtn}">
            </Button>
        </StackPanel>
    </Grid>
</Window>

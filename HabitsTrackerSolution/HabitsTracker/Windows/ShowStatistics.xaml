<Window x:Class="HabitsTracker.Windows.ShowStatistics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitsTracker"
        mc:Ignorable="d"
        Title="Ваш ежедневник" Height="450" Width="550"
        Closing="Window_Closing">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                         RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
            <GradientStop Color="#FFA3D8F4" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
                                CornerRadius="8" 
                                BorderThickness="1.5" 
                                BorderBrush="#87CEEB"
                                Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Выберите дату:" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   FontSize="14"
                   Margin="0,0,10,0"/>
            <DatePicker x:Name="StartDatePicker" 
                    
                    Width="150"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    SelectedDateChanged="StartDatePicker_SelectedDateChanged"/>
            <Button Content="Сегодня" Style="{StaticResource ToolsBtn}" Cursor="Hand" Click="Today_Click"/>
            <Button Content="Сохранить" 
                    Cursor="Hand"
                    Click="SaveToJson_Click"
                    Style="{StaticResource ToolsBtn}" />
            <Button Width="40" Height="40" Click="Refresh_Click" Cursor="Hand"
                    ToolTip="Refresh"
                    Style="{StaticResource ToolsBtn}">
                <TextBlock FontFamily="Segoe MDL2 Assets" 
                           FontSize="16" 
                           Text="&#xE72C;" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Button>
        </StackPanel>

        <DataGrid x:Name="HabitsGrid" 
              Grid.Row="1" 
              AutoGenerateColumns="False" 
              CanUserAddRows="False" 
              CanUserSortColumns="False" 
              HeadersVisibility="All"
              GridLinesVisibility="All"
              Background="Transparent"
              RowBackground="White"
              HorizontalScrollBarVisibility="Disabled"
              AlternatingRowBackground="#F0F8FF"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              Focusable="False">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader" x:Key="HeaderStyle">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="TextBlock" x:Key="ElementStyle">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="FontSize" Value="16"/>

                    <EventSetter Event="MouseDoubleClick" Handler="SeeInfo_Click"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#D0EFFF" Offset="0.0"/>
                                            <GradientStop Color="#C2E6FF" Offset="0.5"/>
                                            <GradientStop Color="#A3DBFF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>

                                    <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" 
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>

                    <Style.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#002D62"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="10,0,10,0"/>
                        </Style>
                    </Style.Resources>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="IsSelected" Value="False"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridRow}, Path=Foreground}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn 
                    Header="Привычка" 
                    HeaderStyle="{StaticResource HeaderStyle}"
                    ElementStyle="{StaticResource ElementStyle}"
                    Binding="{Binding Name}" 
                    Width="180" 
                    IsReadOnly="True">
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>

<Window x:Class="HabitsTracker.Windows.ViewHabitsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabitsTracker"
        mc:Ignorable="d"
        Title="Ваши привычки" Height="300" Width="700"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
                    CornerRadius="8" 
                    BorderThickness="1.5" 
                    BorderBrush="#87CEEB"
                    Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid PreviewMouseDown="Grid_PreviewMouseDown">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
                <GradientStop Color="#FFA3D8F4" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    Margin="10,10,10,5" 
                    VerticalAlignment="Center">

            <Button Content="Сохранить" 
                    Padding="15,6" 
                    Margin="0,0,10,0"
                    Background="#FFA3D8F4"
                    Foreground="#003366"
                    FontWeight="SemiBold"
                    BorderBrush="#87CEEB"
                    Cursor="Hand"
                    Click="SaveToJson_Click"
                    Style="{StaticResource ToolsBtn}" />

            <Button Content="Загрузить" 
                    Padding="15,6" 
                    Margin="0,0,10,0"
                    Background="#FFA3D8F4"
                    Foreground="#003366"
                    FontWeight="SemiBold"
                    BorderBrush="#87CEEB"
                    Cursor="Hand"
                    Click="DownloadHabits_Click"
                    Style="{StaticResource ToolsBtn}" />

            <Button Content="Очистить" 
                    Padding="15,6" 
                    Margin="0,0,10,0"
                    Background="#FFA3D8F4"
                    Foreground="#003366"
                    FontWeight="SemiBold"
                    BorderBrush="#87CEEB"
                    Cursor="Hand"
                    Click="Clear_Click"
                    Style="{StaticResource ToolsBtn}" />
        </StackPanel>

        <DataGrid x:Name="HabitsTable" 
                  Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  HeadersVisibility="Column"
                  GridLinesVisibility="None" 
                  BorderThickness="0"
                  FontSize="14"
                  Foreground="#003366"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  PreviewMouseRightButtonDown="HabitsTable_PreviewMouseRightButtonDown">

            <DataGrid.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
                    <GradientStop Color="#FFA3D8F4" Offset="1"/>
                </RadialGradientBrush>
            </DataGrid.Background>

            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
                                    <ContentPresenter VerticalAlignment="Center" 
                                      HorizontalAlignment="Center" 
                                      SnapsToDevicePixels="True"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#003366"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#003366"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="BorderBrush" Value="#87CEEB"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2.5"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>

                <Style TargetType="TextBlock" x:Key="ElementStyle">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                    <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>

                <Style TargetType="DataGridRow">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="MinHeight" Value="45"/>
                    <Setter Property="Background" Value="#40FFFFFF"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridRow">
                                <Border x:Name="RowBorder" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="#4087CEEB" 
                            BorderThickness="1"    
                            CornerRadius="6"       
                            Margin="1"       
                            SnapsToDevicePixels="True">
                                    <DataGridCellsPresenter SnapsToDevicePixels="True"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Регулярность" Binding="{Binding Regularity}" Width="*" ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*" ElementStyle="{StaticResource ElementStyle}"/>
                <DataGridTextColumn Header="Заметка" Binding="{Binding Note}" Width="*" ElementStyle="{StaticResource ElementStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="OptionViewHabitWindow" 
                Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed" 
                VerticalAlignment="Top" 
                HorizontalAlignment="Left"
                Width="180"
                Height="90"
                CornerRadius="10" 
                BorderThickness="1"
                Padding="8">

            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#A000D2FF" Offset="0"/>
                    <GradientStop Color="#60005599" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>

            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#E6FFFFFF" Offset="0"/>
                    <GradientStop Color="#B0EAF7FF" Offset="0.4"/>
                    <GradientStop Color="#90CCEeff" Offset="0.45"/>
                    <GradientStop Color="#C0FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#0099FF" Opacity="0.4" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Изменить" 
                               FontSize="15" 
                               FontWeight="SemiBold" 
                               Foreground="#004488" 
                               Cursor="Hand"
                               Margin="5,2,5,6"
                               HorizontalAlignment="Center"
                               MouseLeftButtonDown="EditHabit_MouseLeftButtonDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#0099FF"/>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Separator Background="#40003366" Height="1" Margin="10,0"/>

                    <TextBlock Text="Удалить" 
                               FontSize="15" 
                               FontWeight="SemiBold" 
                               Foreground="#004488" 
                               Cursor="Hand"
                               Margin="5,6,5,2"
                               HorizontalAlignment="Center"
                               MouseLeftButtonDown="Delete_MouseLeftButtonDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FF3333"/>
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>

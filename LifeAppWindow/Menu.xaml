<Window x:Class="LifeAppWindow.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LifeAppWindow"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="MainWindow" Height="500" Width="400">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                         RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
            <GradientStop Color="#FFA3D8F4" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
                        CornerRadius="8" 
                        BorderThickness="1.5" 
                        BorderBrush="#87CEEB"
                        Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Grid.Row="1" Grid.Column="0"
            VerticalAlignment="Center"
            Margin="50, 0, 50, 0">
            <Button Content="Привычки" 
            Style="{StaticResource ToolsBtn}" 
            Click="Habits_Click"/>
            <Button Content="Финансы" 
            Style="{StaticResource ToolsBtn}"
            Click="Finace_Click"/>
            <Button Content="Дневник" 
            Style="{StaticResource ToolsBtn}"
            Click="Diary_Click"/>
        </StackPanel>
    </Grid>
</Window>

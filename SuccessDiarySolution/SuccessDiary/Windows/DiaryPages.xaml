<Window x:Class="SuccessDiary.Windows.DiaryPages"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuccessDiary.Windows"
        mc:Ignorable="d"
        Title="Страницы дневника" Height="650" Width="800">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                 RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
            <GradientStop Color="#FFA3D8F4" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
                CornerRadius="8" 
                BorderThickness="1.5" 
                BorderBrush="#87CEEB"
                Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AeroBodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="NumberOfPages"
                    Grid.Row="2"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0, 140, 0, 0">

            <Button Content="←" Height="40" Width="40" Style="{StaticResource ToolsBtn}"/>
            <TextBlock Text="2 / 2" Margin="10, 0, 10, 0" VerticalAlignment="Center" Style="{StaticResource AeroBodyText}"/>
            <Button Content="→" Height="40" Width="40" Style="{StaticResource ToolsBtn}"/>
        </StackPanel>

        <StackPanel x:Name="RandomPageFromDiaryOne"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"   
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Border Width="290"
                    Padding="15"
                    CornerRadius="12" 
                    BorderThickness="1.5" 
                    BorderBrush="#87CEEB"
                    ClipToBounds="True">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F6FDFF" Offset="0.0"/>
                        <GradientStop Color="#D5F4FD" Offset="0.35"/>
                        <GradientStop Color="#AEE7F7" Offset="0.85"/>
                        <GradientStop Color="#8FDDF3" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect Color="#003366"
                                      Direction="270" 
                                      BlurRadius="12" 
                                      ShadowDepth="2" 
                                      Opacity="0.15"/>
                </Border.Effect>

                <StackPanel>

                    <Border CornerRadius="10" 
                            BorderThickness="1" 
                            BorderBrush="#87CEEB" 
                            ClipToBounds="True" 
                            Margin="0,0,0,10">

                        <Image x:Name="RandomDiaryImageOne" 
                               Height="250" 
                               Width="250"
                               Stretch="UniformToFill" 
                               Source="https://pinimg.com"/>
                    </Border>

                    <TextBlock x:Name="CardTitleOne"
                               Text="Заголовок дня" 
                               TextAlignment="Center"
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#003366" 
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CardResultOne"
                               Text="Итог: Отличный прогресс" 
                               TextAlignment="Center"
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#4682B4" 
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CardNoteOne"
                               Text="Сегодня полностью настроили интерфейс дневника в WPF. 
                               Карточка и кнопки теперь выглядят в едином глянцевом стиле. Всё работает стабильно!" 
                               TextAlignment="Center"
                               FontSize="14" 
                               FontWeight="Normal"
                               Foreground="#002244" 
                               LineHeight="18"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="RandomPageFromDiaryTwo"
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="3"
                    Grid.ColumnSpan="3"   
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                            <Border Width="290"
                                    Padding="15"
                                    CornerRadius="12" 
                                    BorderThickness="1.5" 
                                    BorderBrush="#87CEEB"
                                    ClipToBounds="True">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F6FDFF" Offset="0.0"/>
                        <GradientStop Color="#D5F4FD" Offset="0.35"/>
                        <GradientStop Color="#AEE7F7" Offset="0.85"/>
                        <GradientStop Color="#8FDDF3" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect Color="#003366"
                                      Direction="270" 
                                      BlurRadius="12" 
                                      ShadowDepth="2" 
                                      Opacity="0.15"/>
                </Border.Effect>

                <StackPanel>

                    <Border CornerRadius="10" 
                            BorderThickness="1" 
                            BorderBrush="#87CEEB" 
                            ClipToBounds="True" 
                            Margin="0,0,0,10">

                        <Image x:Name="RandomDiaryImageTwo" 
                               Height="250" 
                               Width="250"
                               Stretch="UniformToFill" 
                               Source="https://pinimg.com"/>
                    </Border>

                    <TextBlock x:Name="CardTitleTwo"
                               Text="Заголовок дня" 
                               TextAlignment="Center"
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#003366" 
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CardResultTwo"
                               Text="Итог: Отличный прогресс" 
                               TextAlignment="Center"
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#4682B4" 
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CardNoteTwo"
                               Text="Сегодня полностью настроили интерфейс дневника в WPF. 
                               Карточка и кнопки теперь выглядят в едином глянцевом стиле. Всё работает стабильно!" 
                               TextAlignment="Center"
                               FontSize="14" 
                               FontWeight="Normal"
                               Foreground="#002244" 
                               LineHeight="18"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>

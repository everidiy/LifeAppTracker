<Window x:Class="SuccessDiary.Windows.Diary"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuccessDiary"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Title="Дневник успехов (Frutiger Aero ver.)" Height="700" Width="700">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                     RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
            <GradientStop Color="#FFA3D8F4" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
                    CornerRadius="8" 
                    BorderThickness="1.5" 
                    BorderBrush="#87CEEB"
                    Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="500"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel 
                Grid.Row="1" 
                Grid.Column="0"
                VerticalAlignment="Center"
                Margin="10, 0, 10, 0">
                <Button Content="Добавить страницу" 
                                Style="{StaticResource ToolsBtn}" 
                                Click="Add_Click"/>
                <Button Content="Читать дневник" 
                                Style="{StaticResource ToolsBtn}"
                                Click="Read_Click"/>
        </StackPanel>

        <StackPanel 
                Grid.Row="2" 
                Grid.Column="0"
                VerticalAlignment="Center"
                Margin="10, 0, 10, 0">
                <Button Content="Назад" 
                        Style="{StaticResource ToolsBtn}" 
                        Click="Prev_Click"/>
        </StackPanel>

        <StackPanel x:Name="RandomPageFromDiary"
                    Grid.Row="1" 
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Border x:Name="RandomCard"
                    Width="290"
                    Padding="15"
                    CornerRadius="12" 
                    BorderThickness="1.5" 
                    BorderBrush="#87CEEB"
                    ClipToBounds="True"
                    Visibility="Collapsed">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F6FDFF" Offset="0.0"/>
                        <GradientStop Color="#D5F4FD" Offset="0.35"/>
                        <GradientStop Color="#AEE7F7" Offset="0.85"/>
                        <GradientStop Color="#8FDDF3" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect Color="#003366"
                                      Direction="270" 
                                      BlurRadius="12" 
                                      ShadowDepth="2" 
                                      Opacity="0.15"/>
                </Border.Effect>

                <StackPanel>

                    <Border CornerRadius="10" 
                            BorderThickness="1" 
                            BorderBrush="#87CEEB" 
                            ClipToBounds="True" 
                            Margin="0,0,0,10">
                        
                        <Image x:Name="RandomDiaryImage" 
                               Height="250" 
                               Width="250"
                               Stretch="UniformToFill" 
                               Source="https://pinimg.com"/>
                    </Border>

                    <TextBlock x:Name="CardTitle"
                               Text="Заголовок дня" 
                               TextAlignment="Center"
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#003366" 
                               Margin="0,0,0,4"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CardResult"
                               Text="Итог: Отличный прогресс" 
                               TextAlignment="Center"
                               FontSize="12" 
                               FontWeight="SemiBold" 
                               Foreground="#4682B4" 
                               Margin="0,0,0,10"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="CardNote"
                               Text="Сегодня полностью настроили интерфейс дневника в WPF. 
                               Карточка и кнопки теперь выглядят в едином глянцевом стиле. Всё работает стабильно!" 
                               TextAlignment="Center"
                               FontSize="14" 
                               FontWeight="Normal"
                               Foreground="#002244" 
                               LineHeight="18"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>

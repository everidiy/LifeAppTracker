<Window x:Class="SuccessDiary.Windows.AddPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:SuccessDiary.Windows"
        mc:Ignorable="d"
        Title="AddPage" Height="860" Width="500">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" 
                     RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFD6F0FF" Offset="0.4"/>
            <GradientStop Color="#FFA3D8F4" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="ToolsBtn" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Margin" Value="5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="body" 
                CornerRadius="8" 
                BorderThickness="1.5" 
                BorderBrush="#87CEEB"
                Padding="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#B0E0E6" Offset="0.5"/>
                                    <GradientStop Color="#87CEEB" Offset="0.5"/>
                                    <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="body" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#E0FFFF" Offset="0.5"/>
                                            <GradientStop Color="#AFEEEE" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="body" Property="BorderBrush" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AeroBodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AeroHeaderGotIt" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                        CornerRadius="6" 
                        BorderThickness="1.5" 
                        BorderBrush="#B0E0E6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                    <GradientStop Color="#F9FBFD" Offset="0.5"/>
                                    <GradientStop Color="#F0F8FF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" 
                                  HorizontalScrollBarVisibility="Hidden" 
                                  VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#87CEEB"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0099FF"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#87CEEB" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#B0E0E6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#F4FAFC" Offset="0.4"/>
                        <GradientStop Color="#E6F2F7" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ToggleButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border CornerRadius="6" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                Background="{TemplateBinding Background}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="20" />
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="1" 
                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                      Fill="#003366" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Foreground" Value="#003366"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0FFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#B0E0E6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Зафиксируйте свой успех"
                       Style="{StaticResource AeroHeaderGotIt}"
                       Margin="0,0,0,10"/>

            <TextBlock
                    Name="Description"
                    Style="{StaticResource AeroBodyText}"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    MaxWidth="320"
                    Text="Сохраните моменты гордости и победы.

        Каждая записанная сегодня мысль укрепляет фундамент вашей уверенности."/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Width="280"
                    HorizontalAlignment="Center">

            <TextBlock Text="Заголовок дня:"
                       Style="{StaticResource AeroBodyText}"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="TtileInput"
                     Height="34"
                     Margin="0,0,0,16"
                     Padding="8,4"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <TextBlock Text="Итог:"
                       Style="{StaticResource AeroBodyText}"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="ResultInput"
                      Height="34"
                      Margin="0,0,0,16"
                      SelectedIndex="0"
                      FontSize="14">

                <ComboBoxItem Content="Отличный прогресс"/>
                <ComboBoxItem Content="Хороший день"/>
                <ComboBoxItem Content="Есть над чем работать"/>
                <ComboBoxItem Content="Небольшой шаг вперёд"/>
                <ComboBoxItem Content="Сегодня был отдых"/>

            </ComboBox>

            <TextBlock Text="Записка:"
                   Style="{StaticResource AeroBodyText}"
                   Margin="0,0,0,5"/>

            <TextBox x:Name="NoteInput"
                     Height="90"
                     Margin="0,0,0,10"
                     Padding="8"
                     FontSize="13"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"/>
        </StackPanel>

        <StackPanel 
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,15">

            <Border Width="250"
                    Height="250"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#74C9EF">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F8FEFF" Offset="0.0"/>
                        <GradientStop Color="#D5F4FD" Offset="0.35"/>
                        <GradientStop Color="#AEE7F7" Offset="0.75"/>
                        <GradientStop Color="#8FDDF3" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                              ShadowDepth="2"
                              Opacity="0.2"/>
                </Border.Effect>

                <Border ClipToBounds="True"
                CornerRadius="10"
                Margin="3">
                    <Image x:Name="RandomDiaryImage"
                   Stretch="UniformToFill"/>
                </Border>

            </Border>

            <Button Content="Обновить"
                    Width="180"
                    Height="34"
                    Margin="0,15,0,10"
                    Style="{StaticResource ToolsBtn}"
                    Click="GetRandomPin_Click"/>

            <Button Content="Добавить запись"
                    Width="160"
                    Height="36"
                    Style="{StaticResource ToolsBtn}"
                    Click="Add_Click"/>

        </StackPanel>

        <wv2:WebView2 x:Name="HiddenBrowser"
              Width="1"
              Height="1"
              Visibility="Collapsed"
              />
    </Grid>

</Window>
